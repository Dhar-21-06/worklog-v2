# WorkLog Backend environment configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# SQLite database file (relative to backend/ or absolute path)
DATABASE_URL=sqlite:///./worklog.sqlite

# CORS - local web app origin
CORS_ORIGINS=["http://localhost:3000"]

# Backup / export defaults (overridable in Settings UI later)
BACKUP_DIR=./backups
EXPORT_DIR=./exports
